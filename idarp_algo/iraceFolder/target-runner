#!/bin/bash
# Appelé par irace : target-runner <id config> <id instance> <graine> <instance> <paramètres...>
# Instance : "<jour>/i<n>_<n>_<k>.txt" (instances_<n>.txt avec parameters_<n>.txt, préfixé par irace d'un dossier
# sans importance) :
# instance du jeu d'apprentissage ../../instances/lehavre_rural_irace, en mode horaires des trams du jour
# (tram_runs_<jour>.txt), avec le nombre de véhicules de la solution initiale de main_nb_vehicles
# (JEU=irace MODELE=<modèle> ./run_tests.sh 1 : ../../results/lehavre_sol_init_irace/<modèle>/<jour>/).
# Affiche le coût (objective.txt de main_LNS).
# Variables d'environnement (comme MODELE et OBJECTIF dans run_tests.sh) :
#   IRACE_MODELE   widarp (défaut), idarp ou darp
#   IRACE_OBJECTIF route_time (défaut) ou riding_time

CONFIG_ID=$1
INSTANCE_ID=$2
SEED=$3
INSTANCE_PATH=$4
INSTANCE=$(basename "$INSTANCE_PATH")
DAY=$(basename "$(dirname "$INSTANCE_PATH")")
shift 4

nb_requests_removed_min=$1
largeur_requests_removed=$2
rrt_start_threshold=$3
nb_pt_options=$4

# Nombres de requêtes (main_LNS les borne au nombre de requêtes de l'instance)
nb_requests_removed_max=$(( nb_requests_removed_min + largeur_requests_removed ))

MODELE=${IRACE_MODELE:-widarp}
case "$MODELE" in
    widarp) MODEL_FLAG="" ;;
    idarp)  MODEL_FLAG="-idarp" ;;
    darp)   MODEL_FLAG="-darp" ;;
    *) echo "Erreur: IRACE_MODELE inconnu : $MODELE (widarp, idarp ou darp)" >&2; exit 1 ;;
esac
OBJECTIF=${IRACE_OBJECTIF:-route_time}
case "$OBJECTIF" in
    route_time)  OBJECTIVE_FLAG="" ;;
    riding_time) OBJECTIVE_FLAG="-ridingTime" ;;
    *) echo "Erreur: IRACE_OBJECTIF inconnu : $OBJECTIF (route_time ou riding_time)" >&2; exit 1 ;;
esac

# Chemins absolus, à partir de l'emplacement de ce script (indépendants du dossier d'exécution)
HERE=$(dirname "$(realpath "$0")")
BIN="$HERE/../bin/main_LNS"
INST_DIR=$(realpath "$HERE/../../instances/lehavre_rural_irace")
# config_instance propre au réglage (10 min, sans limite d'itérations) : IRACE_CONFIG_INSTANCE pour un autre
CONF_INST=$(realpath "${IRACE_CONFIG_INSTANCE:-$HERE/config_instance.txt}")
NB_VEHICLES="$(realpath -m "$HERE/../../results/lehavre_sol_init_irace/$MODELE/$DAY")/sol_init_${INSTANCE#i}"
TRAM="tram_runs_${DAY}.txt"

for f in "$INST_DIR/$INSTANCE" "$INST_DIR/$TRAM" "$NB_VEHICLES"; do
    if [ ! -s "$f" ]; then
        echo "Erreur: $f absent (instance $INSTANCE_PATH ; nombre de véhicules : lancer d'abord JEU=irace MODELE=$MODELE ./run_tests.sh 1)" >&2
        exit 1
    fi
done

# Dossier de travail unique pour cet appel (main_LNS y écrit objective.txt)
RUN_DIR="run_${CONFIG_ID}_${INSTANCE_ID}"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR" || exit 1

cat > config.txt <<EOF
nb_requests_removed_min: $nb_requests_removed_min
nb_requests_removed_max: $nb_requests_removed_max
rrt_start_threshold: $rrt_start_threshold
nb_pt_options: $nb_pt_options
EOF

NUMBER=$(echo "$INSTANCE" | sed 's/^i\(.*\)\.txt$/\1/')

rm -f objective.txt

"$BIN" $MODEL_FLAG $OBJECTIVE_FLAG \
    -f "$INST_DIR/" \
    -p "$INSTANCE" \
    -c config.txt \
    -ci "$CONF_INST" \
    -d "d${NUMBER}.txt" \
    -w "w${NUMBER}.txt" \
    -tram "$TRAM" \
    -v "$NB_VEHICLES" \
    -s "$SEED" \
    > solver.log 2>&1

if [ ! -s objective.txt ]; then
    echo "Erreur: objective.txt absent ou vide (config $CONFIG_ID, instance $INSTANCE_PATH), voir $PWD/solver.log" >&2
    exit 1
fi

cat objective.txt
