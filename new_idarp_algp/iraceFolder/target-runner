#!/bin/bash

CONFIG_ID=$1
INSTANCE_ID=$2
SEED=$3
INSTANCE=$(basename "$4")
shift 4

pourcent_nb_requests_removed_min=$1
largeur_requests_removed=$2
record_to_record_value=$3
upper_bound_RRT=$4
ratio_lower_RRT=$5
rate_RRT=$6
update_iteration=$7

pourcent_nb_requests_removed_max=$(( pourcent_nb_requests_removed_min + largeur_requests_removed ))
if [ "$pourcent_nb_requests_removed_max" -gt 100 ]; then
    pourcent_nb_requests_removed_max=100
fi

lower_bound_RRT=$(awk -v u="$upper_bound_RRT" -v r="$ratio_lower_RRT" 'BEGIN { printf "%d", u * r }')

# Chemins absolus, résolus AVANT de changer de dossier
BIN=$(realpath ../bin/main_LNS)
INST_DIR=$(realpath ../../instances/lehavre/)
CONF_INST=$(realpath ../config_instance.txt)
RES_DIR=$(realpath ../../results/lehavre/min_nb_vehicules/wIDARP/)

# Dossier de travail unique pour cet appel
RUN_DIR="run_${CONFIG_ID}_${INSTANCE_ID}"
mkdir -p "$RUN_DIR" "$RES_DIR"
cd "$RUN_DIR" || exit 1

cat > config.txt <<EOF
pourcent_nb_requests_removed_min: $pourcent_nb_requests_removed_min
pourcent_nb_requests_removed_max: $pourcent_nb_requests_removed_max
record_to_record_value: $record_to_record_value
upper_bound_RRT: $upper_bound_RRT
lower_bound_RRT: $lower_bound_RRT
rate_RRT: $rate_RRT
update_iteration: $update_iteration
EOF

NUMBER=$(echo "$INSTANCE" | sed 's/^i30_30_\(.*\)\.txt$/\1/')
DATA="d30_30_${NUMBER}.txt"
WALK="w30_30_${NUMBER}.txt"

rm -f objective.txt

"$BIN" \
    -f "$INST_DIR/" \
    -p "$INSTANCE" \
    -c config.txt \
    -ci "$CONF_INST" \
    -d "$DATA" \
    -w "$WALK" \
    -pt public_transport_time.txt \
    -v "$RES_DIR/$INSTANCE" \
    -s "$SEED" \
    > solver.log 2>&1
# ^ "-s" est un exemple : remplacez par la vraie option de graine de main_LNS

if [ ! -s objective.txt ]; then
    echo "Erreur: objective.txt absent ou vide (config $CONFIG_ID, instance $INSTANCE_ID), voir $PWD/solver.log" >&2
    exit 1
fi

cat objective.txt
